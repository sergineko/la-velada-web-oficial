---
import { SPONSORS } from '@/consts/sponsors'
import SectionTitle from '@/components/SectionTitle.astro'

interface Props {
  class?: string
  variant?: 'default' | 'dark'
}

const { class: className, variant = 'default' } = Astro.props
const isDark = variant === 'dark'
---

<section
  id="sponsors"
  class:list={['mx-auto my-16 w-full max-w-5xl px-4 md:max-w-6xl lg:my-20', className]}
>
  <SectionTitle title="Patrocinadores del Evento" variant={variant} />

  <ul
    class="mt-6 grid list-none grid-cols-2 gap-x-2 gap-y-4 p-0 sm:mt-8 sm:grid-cols-6 sm:gap-x-3 sm:gap-y-4 md:gap-x-4 md:gap-y-5"
    role="list"
  >
    {
      SPONSORS.map(({ url, image, name, label }) => (
        <li class="min-w-0">
          <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label ?? name}
            class:list={[
              'group relative flex min-h-[5.25rem] w-full items-center justify-center rounded-lg px-1 py-2 transition-all duration-300 ease-out sm:min-h-[5.75rem] md:min-h-24 md:px-2 md:py-3',
              'focus-visible:z-20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2',
              isDark
                ? 'text-theme-cream/85 focus-visible:ring-theme-gold/60 focus-visible:ring-offset-theme-midnight hover:z-10 hover:scale-[1.06] hover:text-theme-cream hover:brightness-110 hover:drop-shadow-[0_0_18px_rgba(199,168,107,0.45)] active:scale-[0.98]'
                : 'text-theme-navy focus-visible:ring-theme-navy/50 focus-visible:ring-offset-white hover:z-10 hover:scale-[1.06] hover:brightness-105 hover:drop-shadow-[0_10px_24px_rgba(20,35,70,0.2)] active:scale-[0.98]',
            ]}
          >
            <image.logo
              width={image.width}
              height={image.height}
              class="max-h-16 w-auto max-w-[min(100%,12rem)] object-contain transition-transform duration-300 ease-out will-change-transform group-hover:scale-[1.1] sm:max-h-[5.25rem] md:max-h-[5.85rem] md:max-w-[min(100%,15.5rem)]"
            />
          </a>
        </li>
      ))
    }
  </ul>
</section>
