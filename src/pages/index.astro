---
import Layout from '@/layouts/Layout.astro'
import GoldSectionDivider from '@/components/GoldSectionDivider.astro'
import IbaiSocialNav from '@/components/IbaiSocialNav.astro'
import Sponsors from '@/sections/Sponsors.astro'

const title = 'La Velada del Año VI - Evento de boxeo de Ibai Llanos'
const description =
  'La Velada del Año VI. 25 de julio, 20:00h CET. Evento de boxeo entre streamers organizado por Ibai Llanos.'
const canonical = 'https://www.infolavelada.com/'

const EVENT_DATE = new Date('2026-07-25T20:00:00+02:00')
const timestamp = EVENT_DATE.getTime()

export const prerender = true
---

<Layout title={title} description={description} canonical={canonical}>
  <section
    data-hero
    class="relative flex min-h-screen w-full flex-col items-center justify-between overflow-hidden bg-theme-midnight"
    aria-label="Presentación de La Velada del Año VI"
  >
    <div class="absolute inset-0 z-0 overflow-hidden">
      <picture class="block h-full min-h-full w-full">
        <source srcset="/background.avif" type="image/avif" />
        <source srcset="/background.webp" type="image/webp" />
        <img
          data-bg
          src="/background.png"
          alt=""
          role="presentation"
          class="hero-portada-img h-full min-h-full w-full object-cover object-center opacity-0 transition-opacity duration-1000 ease-in"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 z-[1] h-[14%] bg-linear-to-t from-theme-midnight via-theme-midnight/40 to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>

    <div class="pointer-events-none absolute inset-0 z-[1] bg-linear-to-b from-black/40 via-transparent to-transparent" aria-hidden="true"></div>

    <header class="relative z-20 flex flex-1 flex-col items-center justify-start px-4 pt-20 text-center sm:justify-center sm:pt-12 max-w-3xl mx-auto w-full">
      <h1 class="sr-only">La Velada del Año VI — Evento de boxeo de Ibai Llanos el 25 de julio de 2026</h1>


      <div class="animate-fade-in animate-delay-500 -mt-4" role="img" aria-label="Logo de La Velada del Año VI">
        <picture>
          <source srcset="/logo.avif" type="image/avif" />
          <source srcset="/logo.webp" type="image/webp" />
          <img
            src="/logo.png"
            alt="La Velada del Año VI"
            class="h-auto w-56 sm:w-72 md:w-80 lg:w-96"
            width="384"
            height="384"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>

      <div data-event-info class="animate-fade-in animate-delay-800 mt-6 flex flex-col items-center gap-2 sm:flex-row sm:gap-0">
        <time datetime="2026-07-25" class="font-cinzel text-xs font-bold tracking-[0.2em] text-white sm:text-sm md:text-base">
          25 DE JULIO
        </time>
        <span class="hidden px-4 text-white/40 sm:inline" aria-hidden="true">|</span>
        <time datetime="2026-07-25T20:00:00+02:00" class="font-cinzel text-xs font-bold tracking-[0.2em] text-white sm:text-sm md:text-base">
          20:00H CET
        </time>
        <span class="hidden px-4 text-white/40 sm:inline" aria-hidden="true">|</span>
        <span class="font-cinzel text-xs font-bold tracking-[0.2em] text-white sm:text-sm md:text-base">
          ESTADIO DE LA CARTUJA, SEVILLA
        </span>
      </div>

      <div
        class="animate-fade-in animate-delay-900 mt-8 flex select-none items-center justify-center gap-3 sm:gap-5 md:gap-7"
        id="countdown-hero"
        data-date={timestamp}
        role="timer"
        aria-label="Cuenta atrás para La Velada del Año VI"
      >
        <div class="flex flex-col items-center gap-1">
          <span data-days class="countdown-digit font-cinzel text-3xl font-bold tabular-nums text-theme-cream sm:text-4xl md:text-5xl">---</span>
          <span class="font-cinzel text-[0.55rem] font-semibold tracking-[0.3em] text-white/40 sm:text-[0.65rem]">DÍAS</span>
        </div>
        <span class="self-start mt-1 font-cinzel text-2xl font-light text-theme-gold/30 sm:text-3xl md:text-4xl" aria-hidden="true">:</span>
        <div class="flex flex-col items-center gap-1">
          <span data-hours class="countdown-digit font-cinzel text-3xl font-bold tabular-nums text-theme-cream sm:text-4xl md:text-5xl">--</span>
          <span class="font-cinzel text-[0.55rem] font-semibold tracking-[0.3em] text-white/40 sm:text-[0.65rem]">HORAS</span>
        </div>
        <span class="self-start mt-1 font-cinzel text-2xl font-light text-theme-gold/30 sm:text-3xl md:text-4xl" aria-hidden="true">:</span>
        <div class="flex flex-col items-center gap-1">
          <span data-minutes class="countdown-digit font-cinzel text-3xl font-bold tabular-nums text-theme-cream sm:text-4xl md:text-5xl">--</span>
          <span class="font-cinzel text-[0.55rem] font-semibold tracking-[0.3em] text-white/40 sm:text-[0.65rem]">MIN</span>
        </div>
        <span class="self-start mt-1 font-cinzel text-2xl font-light text-theme-gold/30 sm:text-3xl md:text-4xl" aria-hidden="true">:</span>
        <div class="flex flex-col items-center gap-1">
          <span data-seconds class="countdown-digit font-cinzel text-3xl font-bold tabular-nums text-theme-cream sm:text-4xl md:text-5xl">--</span>
          <span class="font-cinzel text-[0.55rem] font-semibold tracking-[0.3em] text-white/40 sm:text-[0.65rem]">SEG</span>
        </div>
      </div>

      <span
        class="animate-fade-in animate-delay-1000 mt-8 inline-flex cursor-not-allowed items-center justify-center rounded border border-white/20 bg-white/5 px-8 py-3 font-cinzel text-sm font-bold tracking-[0.2em] text-theme-cream sm:text-base"
        aria-disabled="true"
      >
        ENTRADAS AGOTADAS
      </span>
    </header>

    <div class="pointer-events-none relative z-20 h-16 w-full shrink-0 sm:h-20" aria-hidden="true"></div>
  </section>

  <!-- Nueva sección: añade el contenido dentro de #antes-redes-ibai (entre portada y el separador dorado). -->
  <section id="antes-redes-ibai" class="relative bg-theme-midnight" aria-hidden="true"></section>

  <GoldSectionDivider />

  <section
    class="relative scroll-mt-6 bg-theme-midnight px-4 pt-6 pb-3 sm:px-6 sm:pt-8 sm:pb-4"
    aria-label="Redes sociales de Ibai Llanos"
  >
    <div class="animate-fade-in animate-delay-300">
      <IbaiSocialNav />
    </div>
  </section>

  <GoldSectionDivider />

  <section
    class="relative scroll-mt-6 bg-theme-midnight"
    aria-label="Patrocinadores del evento"
  >
    <div class="mx-auto max-w-5xl px-4 pt-8 pb-14 sm:px-6 sm:pt-10 sm:pb-20">
      <Sponsors variant="dark" class="!my-0 w-full max-w-6xl" />
    </div>
  </section>

  <style is:inline>
    [data-hero]:not([data-loaded]) .animate-fade-in {
      animation-play-state: paused !important;
      opacity: 0 !important;
    }
  </style>

  <style>
    .countdown-digit {
      text-shadow: 0 0 30px rgba(199, 168, 107, 0.2);
      min-width: 1.8em;
      text-align: center;
    }

    /**
     * El último ~10 % de la foto de portada se desvanece hacia el fondo (theme-midnight),
     * sin afectar al texto ni al resto de la composición del hero.
     */
    [data-hero] .hero-portada-img {
      mask-image: linear-gradient(to bottom, #000 0%, #000 90%, rgba(0, 0, 0, 0.35) 96%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 90%, rgba(0, 0, 0, 0.35) 96%, transparent 100%);
    }
  </style>

  <script>
    import createCountdown, { type TimeParts } from '@/lib/countdown'

    function initCountdown() {
      const $countdown = document.getElementById('countdown-hero')
      if (!$countdown) return

      const $days = $countdown.querySelector('[data-days]')
      const $hours = $countdown.querySelector('[data-hours]')
      const $minutes = $countdown.querySelector('[data-minutes]')
      const $seconds = $countdown.querySelector('[data-seconds]')

      const timestamp = Number($countdown.getAttribute('data-date') ?? 0)
      return createCountdown(timestamp, {
        onTick({ days, hours, minutes, seconds }: TimeParts) {
          if ($days) $days.textContent = days
          if ($hours) $hours.textContent = hours
          if ($minutes) $minutes.textContent = minutes
          if ($seconds) $seconds.textContent = seconds
        },
        onComplete() {},
      })
    }

    document.addEventListener('astro:page-load', () => {
      const hero = document.querySelector('[data-hero]')
      const bg = hero?.querySelector('[data-bg]') as HTMLImageElement
      if (!hero || !bg) return

      let revealed = false

      function reveal(skipTransition = false) {
        if (revealed) return
        revealed = true

        if (skipTransition) {
          bg.classList.add('!transition-none')
          bg.classList.remove('opacity-0')
          hero!.setAttribute('data-loaded', '')
          return
        }

        bg.addEventListener(
          'transitionend',
          () => hero!.setAttribute('data-loaded', ''),
          { once: true },
        )
        bg.classList.remove('opacity-0')
      }

      if (bg.complete && bg.naturalHeight > 0) {
        reveal(true)
      } else {
        bg.addEventListener('load', () => reveal(false))
        bg.addEventListener('error', () => reveal(true))
        setTimeout(() => reveal(true), 3500)
      }

      initCountdown()?.start()
    })
  </script>
</Layout>
