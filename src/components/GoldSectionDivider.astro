---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div
  class:list={['relative bg-theme-midnight px-4 py-10 sm:px-6 sm:py-12 md:py-14', className]}
  role="presentation"
  aria-hidden="true"
>
  <div class="mx-auto flex max-w-4xl flex-col items-center gap-5">
    <div
      class="h-px w-full max-w-2xl bg-linear-to-r from-transparent via-theme-gold/90 to-transparent shadow-[0_0_12px_rgba(199,168,107,0.35)]"
    >
    </div>
    <div class="flex w-full items-center justify-center gap-3 sm:gap-5">
      <span class="h-px min-w-0 flex-1 max-w-[42%] bg-linear-to-r from-transparent to-theme-gold sm:max-w-[38%]"></span>
      <span class="relative flex size-9 shrink-0 items-center justify-center sm:size-10" aria-hidden="true">
        <span
          class="absolute inset-0 rotate-45 rounded-sm border-2 border-theme-gold bg-theme-midnight shadow-[0_0_22px_rgba(199,168,107,0.55)] ring-4 ring-theme-gold/20"
        ></span>
      </span>
      <span class="h-px min-w-0 flex-1 max-w-[42%] bg-linear-to-l from-transparent to-theme-gold sm:max-w-[38%]"></span>
    </div>
    <div
      class="h-1.5 w-full max-w-lg rounded-full bg-linear-to-r from-transparent via-theme-gold to-transparent opacity-95 shadow-[0_0_28px_rgba(199,168,107,0.4)]"
    >
    </div>
  </div>
</div>
